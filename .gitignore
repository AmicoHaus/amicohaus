# Build output — regenerated by `node build-dist.js`, never edit directly
/dist/

# Wrangler's local cache/dev state
/.wrangler/

# Not currently used, but keep out if it ever shows up
/node_modules/

# Stale site export from before the dist/ build pipeline existed —
# superseded by the tracked source files, kept on disk only as a backup
/amicohaus-site.zip

# Scratch output tools/authz-test.js writes each run (consumed by
# tools/authz-cleanup.js, not meant to be tracked)
/tools/authz-cleanup.json
/tools/authz-cleanup.sql

# Never commit real secrets, in case one ever lands here
.env
.env.*
*.pem
*.key

# Press/outreach drafts — business material, not part of the public site's source
/Press/

# OS/editor noise
.DS_Store
Thumbs.db
